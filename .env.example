PORT=4004

# --- PostgreSQL (local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=procurement
DB_USER=postgres
DB_PASSWORD=changeme
# --- Render Postgres (production): set DATABASE_URL only ---
DATABASE_URL=

# --- Auth ---
# Order of validation in lib/auth/authentication.ts:
#   1. XSUAA (automatic on SAP BTP when an xsuaa instance is bound via VCAP_SERVICES;
#      uses @sap/xssec JWKS validation, tenant = XSUAA subdomain, scopes -> permissions)
#   2. HS256 JWT when JWT_SECRET is set (Render / self-hosted)
#   3. Safe mock via x-mock-user header when ALLOW_MOCK_AUTH=true (local dev ONLY)
JWT_SECRET=dev-only-secret-change-me
JWT_ISSUER=http://localhost:4004
JWT_AUDIENCE=enterprise-ai-procurement
ALLOW_MOCK_AUTH=true

# --- SAP AI Core / Generative AI Hub (optional; mock AI used when unset) ---
AI_API_URL=
AI_API_KEY=
AI_MODEL=anthropic--claude-4-sonnet
AI_PROVIDER=aicore
