PORT=4004

# --- PostgreSQL (local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=procurement
DB_USER=postgres
DB_PASSWORD=changeme
# --- Render Postgres (production): set DATABASE_URL only ---
DATABASE_URL=

# --- Auth ---
# Order of validation in lib/auth/authentication.ts:
#   1. XSUAA (automatic on SAP BTP when an xsuaa instance is bound via VCAP_SERVICES;
#      uses @sap/xssec JWKS validation, tenant = XSUAA subdomain, scopes -> permissions)
#   2. HS256 JWT when JWT_SECRET is set (Render / self-hosted)
#   3. Safe mock via x-mock-user header when ALLOW_MOCK_AUTH=true (local dev ONLY)
JWT_SECRET=dev-only-secret-change-me
JWT_ISSUER=http://localhost:4004
JWT_AUDIENCE=enterprise-ai-procurement
ALLOW_MOCK_AUTH=true

# --- LLM (optional; mock AI used when AI_API_KEY unset) ---
# DeepSeek (OpenAI-compatible): base https://api.deepseek.com.
# Live /v1/models (checked 2026-09-11) serves: deepseek-flash, deepseek-v4-pro.
# NOTE: "deepseek-v4.1-flash" exists only on aggregators (OpenRouter id
# "deepseek/deepseek-v4.1-flash", Novita AI) — NOT on api.deepseek.com, where it
# is rejected. To use it, point AI_API_URL at the aggregator + its key.
# SAP AI Core / GenAI Hub uses the same vars with its own URL + AI_PROVIDER=aicore.
AI_API_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_PROVIDER=deepseek

# --- Remote A2A agent (other server our orchestrator can call) ---
REMOTE_SUPPLIER_AGENT_URL=http://localhost:4007
